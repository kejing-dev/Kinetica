    <!-- status sentence (design content.tone.lines) -->
    <string name="line_s0">Look ahead. Bench coming.</string>
    <string name="line_s1">Tap ▶ Swing on the left, or pinch a ball, pull, let go.</string>
    <string name="line_s2">Pull it where you like, then let go.</string>
    <string name="line_s3">Watch it go. The period\'s on the brass plate.</string>
    <string name="line_s4">All still. Pull another?</string>
    <string name="line_coach2">Tap a tag up top to swap. Drag it up or down to resize.</string>
    <string name="line_slow">Slow-mo</string>
    <string name="stop_disabled">Already still.</string>
    <string name="replay_disabled">Pull one first.</string>
    <string name="gravity_line">On %1$s · %2$s</string>
    <string name="periods_row">L {a} · M {b} · R {c}</string>

    <string name="tip_label">Try this</string>
    <string name="tip_answer_label">Got it</string>
    <string-array name="tip_questions">
        <item>Swap in a heavier ball. Faster?</item>
        <item>Drag a rod\'s tag down to make it longer. Pull again.</item>
        <item>Use ◀ ▶ by the planet on the right. Try the Moon.</item>
        <item>Hang the brass ball on the spring.</item>
        <item>Take the spring to Jupiter. Bounce it up and down. Same rhythm?</item>
        <item>Pull the double up, let go, then hit Swing it again.</item>
    </string-array>
    <string-array name="tip_answers">
        <item>Same beat. Weight doesn\'t matter.</item>
        <item>Slower, right? Longer swings slower.</item>
        <item>Lazy, huh. The Moon doesn\'t pull as hard.</item>
        <item>Springs are different. Heavier, slower.</item>
        <item>Nope. It just hangs lower.</item>
        <item>One millimeter off. Totally different ride.</item>
    </string-array>
    <string name="tips_done">You\'ve tried them all. Go wild.</string>

